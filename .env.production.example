# ==============================================
# PRODUCTION OPTIMIZATION SETTINGS
# PT Putra Wisanggeni Satu
# ==============================================

# -----------------
# Application
# -----------------
APP_NAME="PT Putra Wisanggeni Satu"
APP_ENV=production
APP_DEBUG=false  # IMPORTANT: Set to false in production!
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://www.ptpws.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# -----------------
# Cache Configuration
# -----------------
# Options: file, database, redis, memcached
# Recommended: redis for best performance
CACHE_STORE=file
CACHE_PREFIX=ptpws_

# Session Configuration
SESSION_DRIVER=file  # Change to 'redis' in production for better performance
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true  # Set to true if using HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# -----------------
# Database
# -----------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Database Cache Table (for database cache driver)
DB_CACHE_CONNECTION=mysql
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=mysql
DB_CACHE_LOCK_TABLE=cache_locks

# -----------------
# Redis Configuration
# -----------------
# Uncomment and configure if using Redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1

# -----------------
# Queue Configuration
# -----------------
QUEUE_CONNECTION=sync  # Change to 'redis' or 'database' in production

# -----------------
# Mail Configuration
# -----------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@ptpws.id"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------
# Logging
# -----------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error  # Use 'error' in production, 'debug' in development
LOG_DEPRECATIONS_CHANNEL=null

# -----------------
# Broadcasting
# -----------------
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

# -----------------
# Filesystem
# -----------------
FILESYSTEM_DISK=local

# -----------------
# Performance Optimization
# -----------------
# OPcache should be enabled at PHP level
# Adjust these based on your server resources

# View Caching
VIEW_COMPILED_PATH=

# Asset Versioning
ASSET_URL=

# -----------------
# Security
# -----------------
# Generate with: php artisan key:generate
APP_KEY=

# CSRF Protection
SESSION_CSRF_PROTECTION=true

# -----------------
# Third-Party Services
# -----------------
# Add your API keys here
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=

# -----------------
# Debugging (Development Only)
# -----------------
# TELESCOPE_ENABLED=false
# DEBUGBAR_ENABLED=false

# -----------------
# Optimization Flags
# -----------------
# These are not Laravel env vars, but reminders:
# - Run: php artisan config:cache
# - Run: php artisan route:cache
# - Run: php artisan view:cache
# - Run: composer dump-autoload --optimize --classmap-authoritative
# - Enable OPcache in php.ini
# - Enable Gzip/Brotli compression
# - Setup CDN for static assets
# - Use HTTPS (SSL/TLS)

# -----------------
# Monitoring
# -----------------
# Add monitoring service credentials here
# SENTRY_LARAVEL_DSN=
# NEW_RELIC_LICENSE_KEY=
